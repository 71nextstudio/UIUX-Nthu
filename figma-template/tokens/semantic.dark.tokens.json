  "space": {
    "component-gap": {
      "$type": "number",
      "$value": "{spacing.2}"
    },
    "input-padding-x": {
      "$type": "number",
      "$value": "{spacing.3}"
    },
    "card-padding": {
      "$type": "number",
      "$value": "{spacing.6}"
    },
    "section-gap": {
      "$type": "number",
      "$value": "{spacing.12}"
    }
