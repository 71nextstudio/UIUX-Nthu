        "$value": "{slate.900}"
      },
      "surface": {
        "$type": "color",
        "$value": "{slate.800}"
      },
      "subtle": {
        "$type": "color",
        "$value": "{slate.700}"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{slate.50}"
